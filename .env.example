# 1008 Network Email Alert Configuration

# Recipient Email for incoming pitches, postings & inquiries (Default: join@1008.network)
ALERT_EMAIL_RECIPIENT=join@1008.network

# Sender Email
SENDER_EMAIL=notifications@1008.network

# Option A: Web3Forms Access Key (Simplest: Get free key at https://web3forms.com in 10s)
WEB3FORMS_ACCESS_KEY=your_web3forms_access_key_here

# Option B: Resend API Key (https://resend.com)
# RESEND_API_KEY=re_your_api_key_here

# Option C: Standard SMTP Credentials (Optional alternative)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@domain.com
# SMTP_PASS=your_app_password

# Database (PostgreSQL / Supabase / Neon)
DATABASE_URL=postgresql://user:password@localhost:5432/network1008
