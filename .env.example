# 1008 Network Email Alert Configuration

# Recipient Email for incoming pitches, postings & inquiries (Default: join@1008.network)
ALERT_EMAIL_RECIPIENT=join@1008.network

# Sender Email
SENDER_EMAIL=notifications@1008.network

# Option A: Resend API Key (Recommended for Next.js - https://resend.com)
RESEND_API_KEY=re_your_api_key_here

# Option B: Standard SMTP Credentials (Optional alternative to Resend)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@domain.com
# SMTP_PASS=your_app_password

# Database (PostgreSQL / Supabase / Neon)
DATABASE_URL=postgresql://user:password@localhost:5432/network1008
