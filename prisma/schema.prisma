generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model StudioApplication {
  id                 String   @id @default(cuid())
  fullName           String
  email              String
  phone              String
  linkedinUrl        String
  currentRole        String
  currentCompany     String
  yearsOfExperience  Int
  primaryDomain      String
  city               String
  problemThesis      String
  targetCustomer     String
  unfairAdvantage    String
  timeCommitment     String
  teamNeeds          String[]
  referralSource     String?
  status             String   @default("PENDING_REVIEW")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([email])
  @@index([primaryDomain])
  @@index([status])
}

model Opportunity {
  id                    String                   @id @default(cuid())
  title                 String
  role                  String
  sector                String
  location              String
  equityRange           String
  stipendOrSalary       String?
  founderName           String
  founderHeadline       String
  founderPriorExp       String
  founderDomainYears    Int
  founderEmail          String
  ventureThesis         String
  problemStatement      String
  idealCandidateProfile String[]
  responsibilities      String[]
  studioBacked          Boolean                  @default(false)
  isApproved            Boolean                  @default(true)
  expiresAt             DateTime
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  applications          OpportunityApplication[]

  @@index([role])
  @@index([sector])
  @@index([location])
  @@index([expiresAt])
}

model OpportunityApplication {
  id            String      @id @default(cuid())
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  applicantName String
  email         String
  phone         String
  linkedinUrl   String
  yearsOfExp    Int
  pitchNote     String
  portfolioUrl  String?
  createdAt     DateTime    @default(now())

  @@index([opportunityId])
  @@index([email])
}

model KnowledgeResource {
  id               String   @id @default(cuid())
  slug             String   @unique
  title            String
  subtitle         String
  category         String
  sectorTags       String[]
  readOrWatchTime  String
  authorOrSource   String
  featured         Boolean  @default(false)
  summary          String
  keyTakeaways     String[]
  contentMarkdown  String
  actionableChecklist String[]
  publishedAt      DateTime @default(now())
  createdAt        DateTime @default(now())

  @@index([slug])
  @@index([category])
}

model DealCard {
  id                     String                    @id @default(cuid())
  name                   String
  codeName               String
  oneLiner               String
  sector                 String
  location               String
  stage                  String
  targetRaiseINR         Float
  valuationCapINR        Float
  syndicateAllocationINR Float
  committedPercentage    Float                     @default(0)
  studioBatch            String
  thesis                 String
  status                 String                    @default("Open")
  closingAt              DateTime
  createdAt              DateTime                  @default(now())
  eoiSubmissions         DealExpressionOfInterest[]

  @@index([sector])
  @@index([status])
}

model DealExpressionOfInterest {
  id              String   @id @default(cuid())
  dealId          String
  deal            DealCard @relation(fields: [dealId], references: [id], onDelete: Cascade)
  investorName    String
  investorEmail   String
  investorPhone   String
  investorType    String   // "Angel", "Family Office", "CXO Syndicate", "Fund"
  ticketSizeINR   Float    // in Lakhs
  accreditedStatus Boolean  @default(true)
  notes           String?
  createdAt       DateTime @default(now())

  @@index([dealId])
  @@index([investorEmail])
}

model ReadinessSubmission {
  id                  String   @id @default(cuid())
  fullName            String
  email               String
  score               Int
  tier                String
  domainExperience    String
  problemClarityScore Int
  techReadinessScore  Int
  createdAt           DateTime @default(now())

  @@index([email])
}

model ContactInquiry {
  id        String   @id @default(cuid())
  name      String
  email     String
  company   String?
  type      String   // "Studio Inquiry", "Partner Network", "Investor / Syndicate", "Media / Press"
  message   String
  createdAt DateTime @default(now())

  @@index([email])
  @@index([type])
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  source    String   @default("website_footer")
  createdAt DateTime @default(now())

  @@index([email])
}
